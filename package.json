{
  "name": "intel-workbench-monorepo",
  "version": "1.1.0",
  "description": "情报分析工作台 — 离线智能情报处理与多模态分析系统（monorepo: core 运行时 + server + web）。",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0 <27"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "clean": "pnpm --filter mini-agent clean",
    "build": "pnpm --filter mini-agent build && pnpm --filter @intel-workbench/server build && pnpm --filter @intel-workbench/web build",
    "dev": "pnpm --filter mini-agent dev",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "pnpm --filter mini-agent build && pnpm --filter @intel-workbench/server typecheck && pnpm --filter @intel-workbench/web typecheck",
    "check": "pnpm typecheck && pnpm test:run",
    "eval": "tsx packages/server/eval/run-eval.ts",
    "eval:gen": "tsx packages/server/eval/gen-corpus.ts",
    "eval:contradiction": "tsx packages/server/eval/run-contradiction-eval.ts",
    "eval:agent": "tsx packages/server/eval/run-agent-eval.ts",
    "demo:seed": "pnpm --filter @intel-workbench/server demo:seed",
    "demo:reset": "pnpm --filter @intel-workbench/server demo:reset",
    "e2e:real": "pnpm --filter @intel-workbench/server e2e:real",
    "dev:server": "pnpm --filter @intel-workbench/server dev",
    "dev:web": "pnpm --filter @intel-workbench/web dev",
    "build:server": "pnpm --filter @intel-workbench/server build",
    "build:web": "pnpm --filter @intel-workbench/web build"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RustyPiano/intel-workbench.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/RustyPiano/intel-workbench/issues"
  },
  "homepage": "https://github.com/RustyPiano/intel-workbench#readme"
}
