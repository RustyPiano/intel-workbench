{
  "name": "@intel-workbench/server",
  "version": "1.1.0",
  "private": true,
  "description": "情报分析工作台 API — 鉴权、专题、多模态素材加工、agentic RAG 问答（引用台账）、矛盾检测、要素/时间线、研判简报、自动流水线、报告与哈希链审计。",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "demo:seed": "MINI_AGENT_DEMO=1 tsx src/demo/seed-cli.ts seed",
    "demo:reset": "MINI_AGENT_DEMO=1 tsx src/demo/seed-cli.ts reset",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.eval.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mini-agent": "file:../core",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
